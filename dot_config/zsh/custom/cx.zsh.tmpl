export C4C_API_KEY="{{ (bitwardenFields "item" "CX Okta").c4c_api_key.value }}"
export C4C_STAGING_API_KEY="{{ (bitwardenFields "item" "CX Okta").c4c_staging_api_key.value }}"
export C4NC_API_KEY="{{ (bitwardenFields "item" "CX Okta").c4nc_api_key.value }}"
export C4NC_STAGING_API_KEY="{{ (bitwardenFields "item" "CX Okta").c4nc_staging_api_key.value }}"

export MCP_PIPELINE_HANDLER_GITHUB_TOKEN="{{ (bitwardenFields "item" "GitHub CX").pipeline_handler_mcp_pat.value }}"

alias cx-git='git --git-dir=$HOME/Code/cx/cx-hermes-workspace --work-tree=$HOME/Code/cx'

export ANDROID_HOME="/opt/homebrew/share/android-commandlinetools"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

# Radiant dotfiles helper scripts
export PATH="$HOME/Code/cx/radiant-dotfiles/bin:$PATH"

wt() {
  local base_dir=~/Code/cx/worktrees

  # Find all directories exactly 2 levels deep (project/worktree)
  local selection
  selection=$(find "$base_dir" -mindepth 2 -maxdepth 2 -type d 2>/dev/null \
    | sed "s|$base_dir/||" \
    | fzf --prompt="Select worktree > ")

  # If nothing selected, exit
  [[ -z "$selection" ]] && return

  # cd into the selected worktree
  cd "$base_dir/$selection"
}
